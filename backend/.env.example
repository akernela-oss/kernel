# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma separated list of allowed CORS origins (use * only in dev)
CORS_ORIGINS=*
# Global API prefix
API_PREFIX=api

# ─── Database ──────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://presale:presale_pw@127.0.0.1:5432/presale?schema=public

# ─── Auth / JWT ────────────────────────────────────────────────
# CHANGE THESE IN PRODUCTION — long random strings
JWT_ACCESS_SECRET=change_me_access_secret_please_use_a_long_random_value
JWT_REFRESH_SECRET=change_me_refresh_secret_please_use_a_long_random_value
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
# bcrypt cost factor
BCRYPT_ROUNDS=10

# ─── Rate limiting ─────────────────────────────────────────────
# window in milliseconds and max requests per window per IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
